# Copy to evaluator/.env; never commit real credentials.
# Judge config is independent of agent/.env; see docs/CONFIGURATION.md.
JUDGE_BACKEND=ollama_local
# Python default; cluster evaluation jobs assign the actor's cached model.
JUDGE_MODEL=qwen3:4b-instruct
JUDGE_TIMEOUT_SECONDS=180
# Optional cloud alternative: JUDGE_BACKEND=ollama and a cloud JUDGE_MODEL.
# JUDGE_API_KEY=your-ollama-api-key
# A cloud judge needs its own JUDGE_API_KEY setting, not OLLAMA_API_KEY.
# EVAL_SAMPLE_DIR is a process variable for the balanced Slurm job, not this file.
