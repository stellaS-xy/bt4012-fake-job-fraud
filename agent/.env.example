# Copy to agent/.env; never commit real credentials.
# See docs/CONFIGURATION.md for precedence and every supported setting.
AGENT_BACKEND=ollama_local
# Python default; the supplied cluster jobs use cached qwen2.5:14b-instruct.
OLLAMA_MODEL=qwen3:4b-instruct
# Local mode needs no real API key; cloud mode requires your own key.
OLLAMA_API_KEY=your-ollama-api-key

# auto resolves to ensemble. Linux paths below are relative to the repo root.
CLASSIFIER_BACKEND=ensemble
CLASSIFIER_PYTHON=.venv-mlp/bin/python
CLASSIFIER_ARTIFACT=models/final_ensemble_v1
# Existing cluster export can be used without extraction:
# CLASSIFIER_ARTIFACT=data/processed/final_ensemble_test/v1/artifact
# A separate fresh inference environment can be selected explicitly:
# CLASSIFIER_PYTHON=.venv-final/bin/python
# Windows interpreter example: .venv-final/Scripts/python.exe

# Cloud alternative: AGENT_BACKEND=ollama,
# OLLAMA_MODEL=deepseek-v4.1-flash and your OLLAMA_API_KEY.
# Arbitrary API base URLs and timeout/recursion env keys are not supported.
# Legacy LightGBM requires explicit matching backend, artifact and interpreter.
