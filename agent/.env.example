# Local Ollama: no real API key needed. Keep the Ollama app running.
AGENT_BACKEND='ollama_local'
OLLAMA_MODEL=qwen3:4b-instruct
CLASSIFIER_BACKEND=auto
# Real inference defaults to the modelling environment and locally fitted artifact:
# CLASSIFIER_PYTHON=.venv/Scripts/python.exe
# CLASSIFIER_ARTIFACT=models/agent_lightgbm
OLLAMA_API_KEY=your-ollama-api-key
# For paid cloud use: AGENT_BACKEND=ollama, OLLAMA_MODEL=deepseek-v4.1-flash,
# and replace OLLAMA_API_KEY with your cloud key.
