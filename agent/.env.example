# Local Ollama: no real API key needed. Keep the Ollama app running.
AGENT_BACKEND='ollama_local'
OLLAMA_MODEL=qwen3:4b-instruct
# Final classifier on the cluster: reuse the environment used for job 1177635.
CLASSIFIER_BACKEND=ensemble
CLASSIFIER_PYTHON=.venv-mlp/bin/python
CLASSIFIER_ARTIFACT=models/final_ensemble_v1
# Unpack the verified release ZIP once; no retraining required.
# Legacy LightGBM remains available via an explicit backend/artifact/python override.
OLLAMA_API_KEY=your-ollama-api-key
# For paid cloud use: AGENT_BACKEND=ollama, OLLAMA_MODEL=deepseek-v4.1-flash,
# and replace OLLAMA_API_KEY with your cloud key.
